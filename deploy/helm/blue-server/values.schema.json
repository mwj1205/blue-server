{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "database",
    "redis",
    "game",
    "orleans",
    "jwt"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "environmentName"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "environmentName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "name",
        "user"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "$ref": "#/$defs/port"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "orleans": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "hostingMode",
        "clusteringMode",
        "clusterId",
        "serviceId",
        "redisConnectionString",
        "siloPort",
        "gatewayPort"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostingMode": {
          "type": "string",
          "const": "Kubernetes"
        },
        "clusteringMode": {
          "type": "string",
          "const": "Redis"
        },
        "clusterId": {
          "type": "string",
          "minLength": 1
        },
        "serviceId": {
          "type": "string",
          "minLength": 1
        },
        "redisConnectionString": {
          "type": "string",
          "minLength": 1
        },
        "siloPort": {
          "$ref": "#/$defs/port"
        },
        "gatewayPort": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "jwt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "audience",
        "accessTokenDays"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "accessTokenDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}
