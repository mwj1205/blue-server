# 로컬 개발용 예시 값. 실제 환경에서는 별도의 Secret 저장소 사용 필요
APP_ENVIRONMENT=Production

POSTGRES_DB=bluearchive
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5433

REDIS_PORT=6380

JWT_KEY=THIS_IS_SUPER_SECRET_KEY_FOR_BLUE_SERVER
JWT_ISSUER=blueServer
JWT_AUDIENCE=blueServer
JWT_ACCESS_TOKEN_DAYS=7

API_PORT=5201
GAME_PORT=7777

ORLEANS_CLUSTER_ID=blue-server-local
ORLEANS_SERVICE_ID=blue-server
ORLEANS_ENABLED=true
ORLEANS_CLUSTERING_MODE=Redis
ORLEANS_REDIS_CONNECTION_STRING=redis:6379,abortConnect=false
ORLEANS_SILO_PORT=11111
ORLEANS_GATEWAY_PORT=30000

ELASTIC_VERSION=9.4.2
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
LOGSTASH_API_PORT=9600
APM_SERVER_PORT=18200
ELASTIC_APM_ENVIRONMENT=local
ELASTIC_APM_TRANSACTION_SAMPLE_RATE=1.0
