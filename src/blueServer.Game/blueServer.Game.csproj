<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Orleans\blueServer.GrainContracts\blueServer.GrainContracts.csproj" />
    <ProjectReference Include="..\blueServer.Domain\blueServer.Domain.csproj" />
    <ProjectReference Include="..\blueServer.Infrastructure\blueServer.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Elastic.Apm.EntityFrameworkCore" Version="1.34.5" />
